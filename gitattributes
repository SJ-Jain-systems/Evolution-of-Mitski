# Normalize line endings: store text as LF in the repo, check out native.
* text=auto eol=lf

# Bundled third-party lexicons are vendored data, not this project's source.
# Exclude them from GitHub's language stats and collapse them in diffs.
data/lexicons/valence_afinn.txt        linguist-vendored linguist-generated=false
data/lexicons/pronunciations_cmudict.txt linguist-vendored linguist-generated=false

# Generated analysis tables (rebuilt by scripts/build_dataset.py).
data/processed/*.csv linguist-generated

# Binary assets — never touch line endings, no textual diffs.
*.png  binary
*.gif  binary
*.pdf  binary
